# 이 파일을 복사해서 .env 파일을 만드세요:  cp .env.example .env
# 그런 다음 아래 값을 실제 값으로 채우면 됩니다. (.env는 git에 올라가지 않습니다)

# HuggingFace 액세스 토큰 (read 권한이면 충분)
# 발급: https://huggingface.co/settings/tokens
HF_TOKEN=hf_여기에_본인_토큰

# (선택) 처음 선택될 기본 모델을 고정하고 싶을 때만 설정.
# 모델 자체는 화면의 드롭다운에서 고릅니다. 비워두면 자동으로 골라줍니다.
# HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# DB 연결 정보 (항목별 분리)
# 비밀번호에 @ : / 같은 특수문자가 있어도 코드가 자동 인코딩하므로 날것 그대로 적으세요.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=여기에_DB_비밀번호
DB_NAME=hf_chat_lab

# (참고) SQLite로 바꾸려면 위 DB_* 대신 아래 한 줄만 쓰면 됩니다.
# DATABASE_URL 이 있으면 DB_* 보다 우선합니다.
# DATABASE_URL=sqlite:///./chat.db
