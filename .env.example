# docker compose 용 환경변수 템플릿.
#   cp .env.example .env  후 아래 값을 채우세요. (.env는 git에 올라가지 않습니다)
# 이 값들은 docker-compose.yml이 db/backend 컨테이너에 주입합니다.

# --- 비밀값 (반드시 변경) ---------------------------------------------------
# HuggingFace 액세스 토큰 (read 권한이면 충분). https://huggingface.co/settings/tokens
HF_TOKEN=hf_여기에_본인_토큰

# 로그인 토큰(JWT) 서명용 비밀키. 길고 무작위인 값으로.
#   생성 예) python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=여기에_무작위_긴_문자열

# 관리자 이메일(쉼표로 여러 개). 여기 적힌 이메일은 가입/로그인 시 자동으로 관리자+승인.
ADMIN_EMAILS=여기에_관리자_이메일

# --- DB 접속 정보 (compose의 MySQL과 일치해야 함) ---------------------------
DB_NAME=hf_chat_lab
DB_USER=hfchat
DB_PASSWORD=여기에_DB_비밀번호
# MySQL root 비밀번호 (헬스체크/초기화용)
MYSQL_ROOT_PASSWORD=여기에_root_비밀번호

# --- 보안/환경 -------------------------------------------------------------
# 실행 모드. production이면 JWT_SECRET이 비었거나 기본값일 때 부팅을 막는다(보안 가드).
APP_ENV=production
# CORS 허용 출처(쉼표 구분). nginx가 /api를 프록시하는 단일 오리진 구성에선 보통 불필요.
#   예) ALLOWED_ORIGINS=https://chat.example.com
ALLOWED_ORIGINS=

# --- 선택 ------------------------------------------------------------------
# 처음 선택될 기본 모델을 고정하고 싶을 때만. 비우면 자동 선택.
HF_MODEL=
